rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all (Pillar 4 Global Safety Net)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Entity Validation: UserProfile
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'displayName', 'role']) &&
        data.id is string && data.id == request.auth.uid &&
        data.email is string && data.email.size() <= 150 &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        data.role in ['admin', 'executive', 'chronicler', 'auditor'];
    }

    // Entity Validation: Memory / Chronicle
    function isValidMemory(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'story', 'category', 'date']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.story is string && data.story.size() > 0 && data.story.size() <= 30000 &&
        data.category is string && data.category.size() <= 50 &&
        data.date is string && data.date.size() <= 20;
    }

    // Entity Validation: Chapter
    function isValidChapter(data) {
      return data.keys().hasAll(['id', 'userId', 'title']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 150;
    }

    // Entity Validation: AuditLog
    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'userId', 'action', 'resourceType', 'timestamp']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.action is string && data.action.size() <= 50 &&
        data.resourceType is string && data.resourceType.size() <= 50;
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        // Regular users cannot elevate their own role unless admin
        incoming().role == existing().role || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // MEMORIES / CHRONICLES COLLECTION
    match /memories/{memoryId} {
      allow get: if resource.data.visibility == 'public' || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.visibility == 'department' || isAdmin()));
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(memoryId) && isValidMemory(incoming());
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin()) && isValidMemory(incoming());
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // CHAPTERS COLLECTION
    match /chapters/{chapterId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(chapterId) && isValidChapter(incoming());
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin()) && isValidChapter(incoming());
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // AUDIT LOGS (Immutable corporate compliance trail)
    match /auditLogs/{logId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(logId) && isValidAuditLog(incoming());
      allow update, delete: if false; // Audit logs can NEVER be updated or deleted
    }
  }
}
